# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site (used for invite links and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiveKit Cloud (Project Settings > Keys) ---
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- YouTube Data API v3 (Google Cloud Console) - server only ---
YOUTUBE_API_KEY=your-youtube-data-api-key

# --- GIPHY API (developers.giphy.com) - server only ---
GIPHY_API_KEY=your-giphy-api-key
